{
  "name": "mshin-2d-racing",
  "version": "0.8.9",
  "private": true,
  "type": "module",
  "description": "Mshin 2D top-down arcade racing game; Cocos Creator 3.8.6 and TypeScript",
  "uuid": "b4f38e2e-9a6c-4c3e-ae8c-56c1d00c38a1",
  "creator": {
    "version": "3.8.6"
  },
  "scripts": {
    "validate:data": "node scripts/validate-game-data.mjs",
    "build:core": "tsc -p tsconfig.core.json",
    "check:worker": "node --check workers.js",
    "test": "npm run build:core && node --test tests/*.test.mjs",
