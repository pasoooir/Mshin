NODE_ENV=production
PORT=8788
ALLOWED_ORIGINS=https://pasoooir.github.io
# This must match the secret used by the Cloudflare authentication worker.
AUTH_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
# Private repository used only by the independent JSON API server.
GITHUB_JSON_REPOSITORY=pasoooir/mshin-player-data
GITHUB_JSON_BRANCH=main
GITHUB_JSON_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN
# Development only; never enable in production.
DEV_AUTH_ENABLED=false
DEV_IDENTITIES=admin:100001,player2:100002
