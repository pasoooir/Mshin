; Engine configuration file.
config_version=5

[application]

config/name="Pasoo City BuildIt"
config/description="A beautiful 3D city builder inspired by SimCity BuildIt"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
application/boot_splash/show_image=true
application/boot_splash/image="res://Intro.jpg"
application/boot_splash/fullsize=true
application/boot_splash/use_filter=true
application/boot_splash/bg_color=Color(0.02, 0.06, 0.10, 1)

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
EconomyManager="*res://scripts/autoload/EconomyManager.gd"
StorageManager="*res://scripts/autoload/StorageManager.gd"
BuildManager="*res://scripts/autoload/BuildManager.gd"
FireHazardManager="*res://scripts/autoload/FireHazardManager.gd"
ProductionManager="*res://scripts/autoload/ProductionManager.gd"
CityDemandManager="*res://scripts/autoload/CityDemandManager.gd"
TradeManager="*res://scripts/autoload/TradeManager.gd"
ServiceManager="*res://scripts/autoload/ServiceManager.gd"
TrafficManager="*res://scripts/autoload/TrafficManager.gd"
HappinessManager="*res://scripts/autoload/HappinessManager.gd"
HapticsManager="*res://scripts/autoload/HapticsManager.gd"
LevelProgression="*res://scripts/autoload/LevelProgression.gd"
EpicProjectManager="*res://scripts/autoload/EpicProjectManager.gd"
RegionManager="*res://scripts/autoload/RegionManager.gd"
AchievementManager="*res://scripts/autoload/AchievementManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[input_devices/pointing]
emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.42, 0.7, 0.95, 1)
